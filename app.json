{
  "expo": {
    "name": "Byok Os",
    "slug": "byokos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "byokos",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.byokos.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.byokos.app"
    },
    "web": {
      "favicon": "./src/assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://byokos.app/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "byokos-app"
      }
    }
  }
}
